{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "armory-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Armory Store Management System - Desktop ERP for weapons retailers",
  "author": "Armory Store",
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.armory.store",
    "productName": "Armory Store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"rsbuild dev\" \"wait-on tcp:3000 && cross-env RSBUILD_DEV_SERVER_URL=http://localhost:3000 nodemon\"",
    "build": "python scripts/check-public-env.py && tsc -b && rsbuild build",
    "preview": "rsbuild preview",
    "electron:dev": "concurrently \"rsbuild dev\" \"wait-on tcp:3000 && cross-env RSBUILD_DEV_SERVER_URL=http://localhost:3000 nodemon --watch electron --ext js,ts,json --exec \"tsc -p tsconfig.electron.json && electron .\"\"",
    "build:electron": "python scripts/check-public-env.py && tsc -p tsconfig.electron.json && rsbuild build",
    "start": "nodemon --watch electron --ext js,ts,json --exec \"tsc -p tsconfig.electron.json && electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:supabase": "vitest run src/lib/supabase",
    "supabase:schema:apply": "python scripts/apply-supabase-migrations.py",
    "supabase:verify-auth": "python scripts/verify-supabase-auth.py",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:build:win": "npm run build:electron && electron-builder --win",
    "electron:build:mac": "npm run build:electron && electron-builder --mac",
    "electron:build:linux": "npm run build:electron && electron-builder --linux",
    "verify:supabase": "python scripts/verify-supabase-auth.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "toast": "^0.5.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rspack/core": "^2.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.4",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.25",
    "rollup-plugin-visualizer": "^6.0.11",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  }
}
