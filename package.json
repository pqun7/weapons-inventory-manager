{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "armory-store",
  "private": true,
  "version": "1.1.9",
  "type": "module",
  "description": "Armory Store Management System - Desktop ERP for weapons retailers",
  "author": "Armory Store",
  "repository": {
    "type": "git",
    "url": "https://github.com/pqun7/weapons-inventory-manager.git"
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.armory.store",
    "productName": "Armory Store",
    "copyright": "Copyright © 2026 Armory Store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "supabase/migrations/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!**/*.spec.*"
    ],
    "asar": true,
    "compression": "maximum",
    "electronUpdaterCompatibility": ">=2.16",
    "generateUpdatesFilesForAllChannels": false,
    "win": {
      "icon": "public/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Armory-Store-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Armory Store",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pqun7",
        "repo": "weapons-inventory-manager",
        "releaseType": "release",
        "private": false
      }
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently \"rsbuild dev\" \"wait-on tcp:3000 && cross-env RSBUILD_DEV_SERVER_URL=http://localhost:3000 nodemon\"",
    "build": "python scripts/check-public-env.py && tsc -b && rsbuild build",
    "preview": "rsbuild preview",
    "electron:dev": "concurrently \"rsbuild dev\" \"wait-on tcp:3000 && cross-env RSBUILD_DEV_SERVER_URL=http://localhost:3000 nodemon --watch electron --ext js,ts,json --exec \"tsc -p tsconfig.electron.json && electron .\"\"",
    "build:electron": "python scripts/check-public-env.py && tsc -p tsconfig.electron.json && rsbuild build",
    "start": "nodemon --watch electron --ext js,ts,json --exec \"tsc -p tsconfig.electron.json && electron .\"",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint electron src tests rsbuild.config.ts vitest.config.ts eslint.config.js --max-warnings=0",
    "test": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:python && npm run test:sqlite-provider",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:supabase": "vitest run tests/unit/lib/supabase",
    "test:sqlite-provider": "tsc -p tsconfig.electron.json && cross-env NODE_ENV=test node tests/integration/sqlite-provider.mjs",
    "test:electron-sqlite-smoke": "tsc -p tsconfig.electron.json && cross-env NODE_ENV=test electron tests/integration/electron-sqlite-smoke.mjs",
    "supabase:schema:apply": "python scripts/apply-supabase-migrations.py",
    "supabase:schema:reconcile": "python scripts/reconcile-supabase-migration-history.py",
    "supabase:verify-auth": "python scripts/verify-supabase-auth.py",
    "supabase:verify-readonly": "python scripts/verify-supabase-readonly.py",
    "supabase:verify-owner-adoption": "python scripts/verify-supabase-owner-adoption.py",
    "supabase:test-provider-migration": "python tests/integration/supabase-provider-migration.py",
    "supabase:test-migrated-user-activation": "python tests/integration/supabase-migrated-user-activation.py",
    "supabase:test-deleted-user-reuse": "python tests/integration/supabase-deleted-user-reuse.py",
    "supabase:test-created-user-activation": "python tests/integration/supabase-created-user-activation.py",
    "electron:pack": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --dir",
    "electron:build": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --publish never",
    "electron:build:win": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --win nsis --publish never",
    "electron:publish:win": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --win nsis --publish always",
    "electron:build:mac": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --mac",
    "electron:build:linux": "cross-env ARMORY_GENERIC_BUILD=true npm run build:electron && electron-builder --linux",
    "verify:supabase": "python scripts/verify-supabase-auth.py",
    "reset-db": "python scripts/reset-db.py",
    "seed-db": "python scripts/seed-db.py",
    "test:python": "python -m unittest discover -s tests/python -p \"test_*.py\"",
    "test:db-scripts": "npm run test:python",
    "test:db-integrity": "python scripts/verify-database-integrity.py",
    "db:reset-production": "npm run reset-db"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-table": "^8.21.3",
    "@xmldom/xmldom": "^0.9.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.6.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rspack/core": "^2.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/word-extractor": "1.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.25",
    "rollup-plugin-visualizer": "^6.0.11",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  }
}
