{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "electron/**/*.ts",
    "electron/preload.cts",
    "src/env.d.ts",
    "src/lib/database-provider.ts",
    "src/lib/activation-code.ts",
    "src/lib/manifest-file-types.ts",
    "src/lib/shipment-manifest.ts",
    "src/lib/store-connection.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "tests"
  ]
}
