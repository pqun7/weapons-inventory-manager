# Optional local-development fallback. Generic release builds omit both values
# and collect each store's public connection at runtime on first launch.
# These values are safe to expose only with RLS enabled.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Migration CLI and automated verification only. Keep these in the gitignored
# .env.local file, never prefix them with VITE_, and never bundle or commit them.
# Store owners enter their own values in the packaged app's protected first-run
# form; ordinary users never create or edit an environment file.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=verify-full
SUPABASE_BOOTSTRAP_AUTH_USER_ID=
# Or create the first Auth administrator during migration:
SUPABASE_BOOTSTRAP_EMAIL=
SUPABASE_BOOTSTRAP_PASSWORD=
LEGACY_OWNER_USER_ID=

# Edge Function secret (comma-separated). Use * only for packaged desktop builds
# that do not have a stable HTTP Origin; JWT/admin checks still protect admin-users.
ALLOWED_ORIGINS=http://localhost:3000

# Optional desktop-only AI manifest extraction. Never prefix these with VITE_.
CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-4.1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_ENABLED=true
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_FALLBACK_ON=timeout,rate_limit,service_unavailable,invalid_api_key,invalid_response

# Optional first administrator created by `npm run reset-db -- --confirm`.
RESET_ADMIN_NAME=Primary Admin
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=

# Optional Gmail SMTP for SQLite administrator password recovery. Gmail SMTP
# has free account quotas; use a Google App Password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=administrator@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=administrator@gmail.com
SMTP_FROM_NAME=Armory Store

# Used by `npm run seed-db -- --confirm` only when reset-db did not create an Admin.
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
